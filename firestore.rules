rules_version = '2';
// Only signed-in Google accounts with a verified @carbontree.com email can use Stock Desk.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeam() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@carbontree[.]com$');
    }

    // Reports are identified by code DDMMYY-NN (e.g. 240926-01).
    match /reports/{code} {
      allow read: if isTeam();
      allow create: if isTeam()
        && code.matches('^[0-9]{6}-[0-9]{2}$')
        && request.resource.data.code == code
        && request.resource.data.md is string
        && request.resource.data.md.size() < 900000
        && request.resource.data.uploadedBy.uid == request.auth.uid;
      // Reports are a record: no edits after upload. Only the uploader can delete.
      allow update: if false;
      allow delete: if isTeam() && resource.data.uploadedBy.uid == request.auth.uid;

      match /notes/{noteId} {
        allow read: if isTeam();
        allow create: if isTeam()
          && request.resource.data.by.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if isTeam() && resource.data.by.uid == request.auth.uid;
      }
    }

    // One counter per report date, used to hand out the -01, -02 ... suffix.
    match /counters/{day} {
      allow read: if isTeam();
      allow create, update: if isTeam()
        && day.matches('^[0-9]{6}$')
        && request.resource.data.next is int;
    }
  }
}
