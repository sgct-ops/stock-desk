rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Stock Desk — Firestore security rules
//
//   shantanu@carbontree.com  owner:  read, upload reports, delete own reports, notes
//   kabir@carbontree.com     member: read reports, add/edit own notes
//   anyone else              no access (the app tells them to speak to Shantanu)
//
// Keep the two emails in sync with lib/roles.ts. These rules are what protect the
// data; the app only hides screens.
//
// Data:
//   reports/{code}             code = DDMMYY-NN, immutable once created
//   reports/{code}/notes/{id}  one note, editable/deletable by its author only
//   counters/{DDMMYY}          { next } — the next -NN for that date
// Everything not matched below is denied.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInEmail() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function email()    { return request.auth.token.email.lower(); }
    function isOwner()  { return signedInEmail() && email() == 'shantanu@carbontree.com'; }
    function isMember() { return signedInEmail() && email() in ['shantanu@carbontree.com', 'kabir@carbontree.com']; }

    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function counterPath(day) { return /databases/$(database)/documents/counters/$(day); }
    function reportPath(code) { return /databases/$(database)/documents/reports/$(code); }

    function validPerson(p) {
      return p is map
          && p.keys().hasOnly(['uid', 'name', 'email'])
          && p.uid == request.auth.uid
          && p.name is string && p.name.size() <= 200
          && p.email is string && p.email.lower() == email();
    }
    function validCount(c) {
      return c is map && c.keys().hasOnly(['products', 'sizes'])
          && c.products is int && c.products >= 0
          && c.sizes is int && c.sizes >= 0;
    }
    function validStats(s) {
      return s is map
          && s.keys().hasOnly(['on', 'off', 'watch', 'ok', 'short'])
          && validCount(s.on) && validCount(s.off) && validCount(s.watch) && validCount(s.ok)
          && s.short is number && s.short >= 0;
    }

    match /reports/{code} {
      allow read: if isMember();

      // A new report must:
      //  - have an id DDMMYY-NN that matches its own date and seq fields,
      //  - be created in the same write as its date's counter moving to seq + 1
      //    (so codes can't be skipped, reused or guessed),
      //  - carry only the known fields, stamped with the server time and the uploader.
      allow create: if isOwner()
        && code.matches('^[0-9]{6}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['code', 'date', 'seq', 'title', 'md', 'fileName', 'stats', 'uploadedAt', 'uploadedBy'])
        && request.resource.data.keys().hasAll(['code', 'date', 'seq', 'md', 'stats', 'uploadedAt', 'uploadedBy'])
        && request.resource.data.code == code
        && request.resource.data.date is string
        && request.resource.data.date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && code == request.resource.data.date[8:10] + request.resource.data.date[5:7] + request.resource.data.date[2:4] + '-' + pad2(request.resource.data.seq)
        && request.resource.data.seq is int
        && request.resource.data.seq >= 1 && request.resource.data.seq <= 99
        && getAfter(counterPath(code[0:6])).data.next == request.resource.data.seq + 1
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.md is string
        && request.resource.data.md.size() > 0 && request.resource.data.md.size() < 900000
        && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 300
        && validStats(request.resource.data.stats)
        && request.resource.data.uploadedAt == request.time
        && validPerson(request.resource.data.uploadedBy);

      // Reports are a record: never edited. Upload a new -NN instead.
      allow update: if false;

      // Only Shantanu, and only reports he uploaded.
      allow delete: if isOwner() && resource.data.uploadedBy.uid == request.auth.uid;

      match /notes/{noteId} {
        allow read: if isMember();
        allow create: if isMember()
          && exists(reportPath(code))
          && request.resource.data.keys().hasOnly(['text', 'by', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.at == request.time
          && validPerson(request.resource.data.by);
        // Authors can fix the text of their own note; nothing else changes.
        allow update: if isMember()
          && resource.data.by.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow delete: if isMember() && resource.data.by.uid == request.auth.uid;
      }
    }

    // counters/{DDMMYY}: moves up by exactly one, and only in the same write that
    // creates the report it hands a number to.
    match /counters/{day} {
      allow read: if isOwner();
      allow create: if isOwner()
        && day.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == 2
        && existsAfter(reportPath(day + '-01'))
        && !exists(reportPath(day + '-01'));
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1
        && request.resource.data.next <= 100
        && existsAfter(reportPath(day + '-' + pad2(resource.data.next)))
        && !exists(reportPath(day + '-' + pad2(resource.data.next)));
      allow delete: if false;
    }
  }
}
